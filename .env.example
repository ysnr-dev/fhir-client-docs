# 撮影に使う開発環境のログイン。役割ごとに 1 アカウント。値は .env に書く(.env は git 管理外)。
# 職員と患者は fhir-client の撮影用データ(demo-seed の manualShots)が作る。README「撮影用のデータ」参照。
SHOTS_BASE_URL=http://localhost:5173
# 医師(医師 四郎)。ログイン ID は shiro。パスワードは撮影用データを流すときに決める。
SHOTS_DOCTOR_LOGIN=shiro
SHOTS_DOCTOR_PASSWORD=
# 看護師(看護 次郎)。ログイン ID は nurse2。パスワードは撮影用データを流すときに決める。
SHOTS_NURSE_LOGIN=nurse2
SHOTS_NURSE_PASSWORD=
# 看護サマリーを承認する看護師(看護 夏子)。ログイン ID は natsuko。パスワードは撮影用データを流すときに決める。
SHOTS_HEAD_NURSE_LOGIN=natsuko
SHOTS_HEAD_NURSE_PASSWORD=
# 薬剤師(薬剤 三郎)。ログイン ID は pharma。パスワードは撮影用データを流すときに決める。
SHOTS_PHARMACIST_LOGIN=pharma
SHOTS_PHARMACIST_PASSWORD=
# 研修医(研修 五郎)。ログイン ID は goro。指導医は医師 四郎(撮影用データの指導医グループ「見本 内科研修」)。
SHOTS_RESIDENT_LOGIN=goro
SHOTS_RESIDENT_PASSWORD=
# 臨床検査技師(検査 春子)。ログイン ID は labtech。パスワードは撮影用データを流すときに決める。
SHOTS_LAB_TECH_LOGIN=labtech
SHOTS_LAB_TECH_PASSWORD=
# 病理医(病理 六郎)。ログイン ID は patho。パスワードは撮影用データを流すときに決める。
SHOTS_PATHOLOGIST_LOGIN=patho
SHOTS_PATHOLOGIST_PASSWORD=
# 診療放射線技師(放射 七郎)。ログイン ID は radtech。パスワードは撮影用データを流すときに決める。
SHOTS_RAD_TECH_LOGIN=radtech
SHOTS_RAD_TECH_PASSWORD=
# 放射線科医(読影 八郎)。ログイン ID は dokuei。パスワードは撮影用データを流すときに決める。
SHOTS_RADIOLOGIST_LOGIN=dokuei
SHOTS_RADIOLOGIST_PASSWORD=
# 麻酔科医(麻酔 九郎)。ログイン ID は masui。パスワードは撮影用データを流すときに決める。
SHOTS_ANESTHESIOLOGIST_LOGIN=masui
SHOTS_ANESTHESIOLOGIST_PASSWORD=
# 理学療法士(理学 冬子)。ログイン ID は rigaku。パスワードは撮影用データを流すときに決める。
SHOTS_THERAPIST_LOGIN=rigaku
SHOTS_THERAPIST_PASSWORD=
# 臨床工学技士(工学 十郎)。ログイン ID は kougaku。パスワードは撮影用データを流すときに決める。
SHOTS_CLINICAL_ENGINEER_LOGIN=kougaku
SHOTS_CLINICAL_ENGINEER_PASSWORD=
# 管理栄養士(栄養 桃子)。ログイン ID は eiyou。パスワードは撮影用データを流すときに決める。
SHOTS_DIETITIAN_LOGIN=eiyou
SHOTS_DIETITIAN_PASSWORD=
# 地域連携室の社会福祉士(連携 菊子)。ログイン ID は renkei。パスワードは撮影用データを流すときに決める。
SHOTS_LIAISON_LOGIN=renkei
SHOTS_LIAISON_PASSWORD=
